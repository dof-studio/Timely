// Introduce prjname API to Set Project Name
template <typename _Ty>
inline void prjname(_Ty arg) noexcept{
    libnocppsh::libtimely::__GlobalTimelyProjectNameSet__(arg);
}

// Introduce timely Traceback API to Get Snapshot
template<typename _BoolTyp = libnocppsh::libtimely::_BoolType>
inline auto traceback(_BoolTyp stop_ = false) noexcept{
    return libnocppsh::libtimely::__GlobalStackFrameSnapshotCallback__(stop_);
}

// Introduce Automatic Function Signature Macro
#if defined(__GNUC__) || defined(__clang__)
    #define __FUNCTION_SIGNATURE__   __PRETTY_FUNCTION__
#elif defined(_MSC_VER)
    #define __FUNCTION_SIGNATURE__   __FUNCSIG__  // Later MSVC also supports this
#else
    #define __FUNCTION_SIGNATURE__   __func__     // Fallback
#endif

// Introduce Timely Easy-to-Create Generic Macro
#if __timelyon__

    // Easy Implementation
    #ifndef TIMELY_
    #define TIMELY_        constexpr auto __timely_thash__ = thash(__FUNCTION_SIGNATURE__); \
                           const auto __timely_object__ = Timely<0>(__FUNCTION_SIGNATURE__, __timely_thash__);
    #endif

    // Generic Implementation
    #ifndef TIMELY
    #define TIMELY(x)      constexpr auto __timely_thash__ = thash(x); \
                           const auto __timely_object__ = Timely<0>(x, __timely_thash__);
    #endif

#else
    #ifndef TIMELY_
    #define TIMELY_
    #endif

    #ifndef TIMELY
    #define TIMELY(x) 
    #endif
#endif

