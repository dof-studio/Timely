// Introduce Timely Hash Interfaces
template<typename _CharTyp = libnocppsh::libtimely::_CharType>
inline constexpr auto thash(const _CharTyp* str) noexcept {
    return libnocppsh::libtimely::_Timely_Hash(str);
}
template<typename _Ty, typename... _Rest>
requires std::is_same_v<_Ty, const libnocppsh::libtimely::_CharType*>
inline constexpr libnocppsh::libtimely::_HashType _Timely_Hash(_Ty str, _Rest... rest) noexcept {
    return libnocppsh::libtimely::_Timely_Hash(str, rest...);
}

// Introduce Timely Generic API Interfaces
template <libnocppsh::libtimely::_ThreadIdType _ThreadId = 0, typename _MD = libnocppsh::libtimely::_Timely_MemoryModel_Heaplike>
using Timely = libnocppsh::libtimely::_Timely<_ThreadId, _MD>;

// Introduce Timely Generic API Interfaces Default by Coverage
template <libnocppsh::libtimely::_ThreadIdType _ThreadId = 0, typename _MD = libnocppsh::libtimely::_Timely_MemoryModel_Coverage>
